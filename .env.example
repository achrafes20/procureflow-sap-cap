# Le mode local est actif par défaut et ne nécessite aucun accès SAP.
S4_MODE=local

# Pour le mode réel, remplacez les valeurs puis utilisez un fichier .env local.
# Ne versionnez jamais un vrai mot de passe.
S4_API_URL=https://votre-systeme-api.s4hana.cloud.sap/sap/opu/odata4/sap/api_purchaseorder_2/srvd_a2x/sap/purchaseorder/0001
S4_USERNAME=votre-utilisateur-technique
S4_PASSWORD=votre-mot-de-passe
S4_MAX_ORDERS=100
S4_COMPANY_CODE=1710
S4_PURCHASING_ORG=1710
S4_PURCHASING_GROUP=001
S4_PLANT=1710
S4_ORDER_TYPE=NB
S4_DEFAULT_MATERIAL_GROUP=001
